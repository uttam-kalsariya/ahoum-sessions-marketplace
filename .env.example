# ==============================================================================
# Ahoum Sessions Marketplace - Environment Configuration Template
# Copy this file to `.env` before starting the application:
#   cp .env.example .env
# ==============================================================================

# Django Backend Configuration
DJANGO_SECRET_KEY=django-insecure-ahoum-marketplace-production-grade-key-2026-xyz!
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# PostgreSQL Database Configuration
DB_HOST=db
DB_PORT=5432
DB_NAME=marketplace_db
DB_USER=marketplace_user
DB_PASSWORD=marketplace_secret_2026

# JWT Token Configuration
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# OAuth Authentication (Optional - Instant Demo Sign-in works out-of-the-box)
# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend Configuration
VITE_API_URL=/api
