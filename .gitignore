# ==============================================================================
# Ahoum Sessions Marketplace - .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Django Databases & Logs
*.log
local_settings.py
*.sqlite3
*.sqlite3*
db.sqlite3
db.sqlite3-journal
test_db.sqlite3
media/
staticfiles/

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Node & Frontend Build
node_modules/
frontend/node_modules/
dist/
build/
frontend/dist/
frontend/build/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln

# Docker & Scratch
.docker/
scratch/
